{
	"name": "@agentic-inbox/cli",
	"version": "0.1.0",
	"license": "Apache-2.0",
	"type": "module",
	"private": true,
	"bin": {
		"inbox": "./src/main.ts"
	},
	"scripts": {
		"lint": "biome check .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"gen": "openapi-typescript ./openapi.json -o src/generated/api.d.ts && biome format --write src/generated/api.d.ts",
		"build": "bun run build:all",
		"build:all": "bash scripts/build-all.sh"
	},
	"dependencies": {
		"commander": "^14.0.3",
		"openapi-fetch": "^0.17.0",
		"zod": "^4.3.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@types/bun": "^1.3.11",
		"openapi-typescript": "^7.13.0",
		"typescript": "^5.9.3"
	}
}
