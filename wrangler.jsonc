{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "agentic-inbox-hei",
	"account_id": "a12823016aa16d0a8dd2678b258bd751",
	"compatibility_date": "2025-11-28",
	"main": "./workers/app.ts",
	"routes": [
		{
			"pattern": "mail.hei.dev",
			"custom_domain": true
		},
		// Browsers redirect to CANONICAL_HOST. API keys, the REST API and MCP keep working here.
		{
			"pattern": "mail.harbouredgeintelligence.com.au",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		// Production deploys must also set the CLERK_SECRET_KEY and ALLOWED_EMAILS secrets.
		// The worker fails closed outside local development if Clerk is not configured.
		"CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuaGVpLmRldiQ",
		"CLERK_SIGN_IN_URL": "https://accounts.hei.dev/sign-in",
		"CANONICAL_HOST": "mail.hei.dev",
		"DOMAINS": "harbouredgeintelligence.com.au,hei.dev",
		"EMAIL_ADDRESSES": []
	},
	"send_email": [
		{
			"name": "EMAIL",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "agentic-inbox",
			"preview_bucket_name": "agentic-inbox"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "MAILBOX",
				"class_name": "MailboxDO"
			},
			{
				"name": "EMAIL_AGENT",
				"class_name": "EmailAgent"
			},
			{
				"name": "EMAIL_MCP",
				"class_name": "EmailMCP"
			},
			{
				"name": "API_KEYS",
				"class_name": "ApiKeyStore"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"MailboxDO"
			]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": [
				"EmailAgent"
			]
		},
		{
			"tag": "v3",
			"new_sqlite_classes": [
				"EmailMCP"
			]
		},
		{
			"tag": "v4",
			"new_sqlite_classes": [
				"ApiKeyStore"
			]
		}
	]
}
